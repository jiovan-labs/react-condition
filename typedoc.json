{
    "name": "React Condition",
    "entryPoints": [
        "src/index.ts"
    ],
    "disableSources": true,
    "excludeExternals": true,
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "hideGenerator": true,
    "highlightLanguages": [
        "bash",
        "html",
        "js",
        "json",
        "jsx",
        "ts",
        "tsx"
    ],
    "includeVersion": false,
    "navigationLinks": {
        "GitHub": "https://github.com/joivan-labs/react-condition",
        "Jiovan": "https://joivan.com"
    },
    "plugin": [
        "@jiovan-labs/typedoc-plugin-raw-content",
        "@jiovan-labs/typedoc-theme-dumi"
    ],
    "theme": "dumi",
    "rawHeadEnds": [
        "<meta name='keywords' content='typescript, jiovan, react-condition'/>"
    ],
    "rawFooterEnds": [
        "<div style='text-align: center'>Copyright &copy; 2026 Jiovan Ltd. All rights reserved</div>"
    ],
    "logoImage": "https://jiovan-labs.github.io/assets/ico/logo-icon.svg",
    "logoWidth": 32,
    "logoHeight": 32,
    "logoTitle": "@jiovan-labs/react-condition",
    "navigationLinkTargets": {
        "GitHub": "_blank",
        "Jiovan": "_blank"
    },
    "preventModulesLink": true,
    "hideIndexContentTitle": true,
    "footerAlign": "center"
}
