{
    "name": "@jiovan-labs/react-condition",
    "version": "2.0.0",
    "title": "React Condition",
    "description": "Render components conditionally for react",
    "homepage": "https://jiovan-labs.github.io/react-condition",
    "organization": "Jiovan Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "react-condition",
        "if",
        "if-then",
        "if-else",
        "if-then-else",
        "for",
        "switch",
        "while",
        "do-while",
        "while-do",
        "map-iterator",
        "set-iterator",
        "object-iterator",
        "condition",
        "condition-render",
        "control-statement"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "unpkg": "dist/umd/react-condition.min.js",
    "types": "dist/esm/index.d.ts",
    "sideEffects": false,
    "scripts": {
        "approve": "npm approve-scripts --allow-scripts-pending",
        "build": "del-cli ./dist && father build",
        "build:doctor": "father doctor",
        "build:watch": "father dev",
        "docs:build": "typedoc --out ./docs-dist",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "test": "jest",
        "test:coverage": "del-cli ./coverage && jest --coverage --coverageDirectory ./coverage",
        "upgrade": "npx npm-check-updates --target semver -u"
    },
    "dependencies": {
        "@babel/runtime": "^7.29.10"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@jiovan-labs/babel-plugin-remove-comment": "^2.0.0",
        "@jiovan-labs/typedoc-plugin-raw-content": "^2.0.0",
        "@jiovan-labs/typedoc-theme-dumi": "^2.0.0",
        "del-cli": "^7.0.0",
        "eslint": "^10.14.0",
        "eslint-plugin-jest": "^29.17.0",
        "father": "^4.6.41",
        "gh-pages": "^6.3.0",
        "globals": "^17.14.0",
        "jest-environment-jsdom": "^30.5.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "ts-jest": "^29.4.15",
        "typedoc": "~0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "peerDependencies": {
        "react": ">=17.0.0",
        "react-dom": ">=17.0.0",
        "typescript": ">=4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/joivan-labs/react-condition.git"
    },
    "bugs": {
        "url": "https://github.com/joivan-labs/react-condition/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "collective": {
        "url": "https://opencollective.com/joivan-labs"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/joivan-labs"
        },
        {
            "type": "individual",
            "url": "https://joivan.com/donation"
        }
    ],
    "author": {
        "name": "Jiovan Ltd",
        "url": "https://joivan.com"
    },
    "contributors": [
        {
            "name": "David Hsing",
            "email": "davidhsing@163.com",
            "url": "https://github.com/davidhsing"
        }
    ],
    "allowScripts": {
        "@parcel/watcher": true,
        "core-js": true,
        "core-js-pure": true,
        "esbuild": true,
        "fsevents": true,
        "unrs-resolver": true
    }
}
